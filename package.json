{
  "name": "subtitledb-stremio",
  "version": "0.2.1",
  "private": true,
  "description": "Stremio addon for TheSubtitleDB.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
